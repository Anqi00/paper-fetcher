# Optional: improves Semantic Scholar rate limits.
S2_API_KEY=

# Summary backend: none | ollama | gemini
SUMMARY_BACKEND=none
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_NUM_CTX=12288
GEMINI_MODEL=gemini-2.5-flash
# 1 = read arXiv full text when summarising, 0 = abstract only
SUMMARY_USE_FULLTEXT=1
# Long papers are read in chunks of this many characters (max FULLTEXT_MAX_CHUNKS)
FULLTEXT_CHUNK_CHARS=20000
FULLTEXT_MAX_CHUNKS=6
# Optional: free key from dev.elsevier.com; full text for ScienceDirect open-access
# articles, and subscribed ones when run on a subscribing institution's network
ELSEVIER_API_KEY=

# Optional email delivery
EMAIL_TO=
EMAIL_FROM=
EMAIL_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
